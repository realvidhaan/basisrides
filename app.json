{
  "expo": {
    "name": "Ridr",
    "slug": "ridr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ridr",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vidhaan.ridr",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vidhaan.ridr",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F5F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ridr uses your location during an active carpool trip so riders can see the driver's car move in real time and pickups happen at the right spot. Your location is shared only with parents in your carpool, and only while a trip is in progress.",
          "locationAlwaysAndWhenInUsePermission": "Ridr shares your live location with your carpool riders only while you're driving a trip.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F8B8D",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "vidhaans-projects",
          "project": "react-native"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5ffe6fcd-0b69-4339-9e8f-7689991fefb4"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5ffe6fcd-0b69-4339-9e8f-7689991fefb4"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "owner": "vidhaanjs-team"
  }
}
